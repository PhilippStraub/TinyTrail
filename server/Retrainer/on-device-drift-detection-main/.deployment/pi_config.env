# Pi Configuration for TinyLCM Drift Detection
# ============================================

# Pi connection settings
PI_DEFAULT_USER=pi
PI_PROJECT_PATH=/home/pi/tinylcm_drift_detection

# Python environment
PYTHON_VERSION=3.11
VIRTUAL_ENV_PATH=${PI_PROJECT_PATH}/venv

# Hardware settings
ENABLE_CAMERA=true
GPU_MEM=128

# Performance settings
CPU_GOVERNOR=performance
SWAP_SIZE=1024

# Directories
LOG_DIR=${PI_PROJECT_PATH}/logs
DEBUG_DIR=${PI_PROJECT_PATH}/debug
MODEL_DIR=${PI_PROJECT_PATH}/examples/python_examples

# Scenarios
SCENARIO_LEGO_PATH=${MODEL_DIR}/scenario_lego_drift
SCENARIO_BALL_PATH=${MODEL_DIR}/scenario_ball_drift

# Network settings
SSH_TIMEOUT=5
RSYNC_FLAGS=-avz --exclude='*.pyc' --exclude='__pycache__' --exclude='.git'

# Dependencies
CORE_DEPS="numpy==1.24.2 scikit-learn==1.4.2 opencv-python-headless==4.9.0.80 Pillow==10.3.0 psutil==5.9.8"
OPTIONAL_DEPS="picamera2 matplotlib"

# Log settings  
MAX_LOG_SIZE=100MB
LOG_ROTATION=daily
KEEP_LOGS=7