{
  "device": {
    "name": "Raspberry Pi Zero 2W",
    "description": "CIFAR-10 folder-based drift detection (NearestCentroid)",
    "log_level": "INFO"
  },
  "image_input": {
  "input_dir": "./input_images",
  "recursive": true,
  "loop_forever": false,
  "supported_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".bmp",
    ".webp"
  ],
  "sort_mode": "name",
  "skip_non_image_files": true,
  "ground_truth_from_parent_dir": true,
  "shuffle_files": true,
  "shuffle_seed": 42,
  "inference_resolution": [
    32,
    32
  ],
  "delay_ms": 200
},
  "model": {
    "model_path": "./model/model_object.tflite",
    "labels_path": "./model/labels_object.txt",
    "threshold": 0.75
  },
  "tinylcm": {
    "feature_extractor": {
      "type": "TFLiteFeatureExtractor",
      "model_path": "./model/model_object.tflite",
      "feature_layer_index": 0,
      "normalize_features": false,
      "lazy_loading": false
    },
    "feature_transformation": {
      "type": "StandardScalerPCA",
      "model_path": "./model/feature_processor.npz",
      "format": "npz",
      "enabled": true
    },
    "adaptive_classifier": {
      "type": "NearestCentroidClassifier",
      "k": 3,
      "max_samples": 200,
      "distance_metric": "euclidean",
      "weight_by_distance": true,
      "idw_power": 3.0,
      "initial_state_path": "./initial_state/knn_initial_state_objects.json"
    },
    "drift_detectors": [
      {
        "type": "KNNDistanceMonitor",
        "delta": 0.99,
        "lambda_threshold": 9.91,
        "exit_threshold_factor": 0.7,
        "high_confidence_threshold": 0.9,
        "stable_known_classes": ["airplane", "automobile", "bird", "cat", "deer", "dog", "frog", "horse", "ship", "truck"],
        "reference_stats_path": "./initial_state/knn_reference_stats.json",
        "warm_up_samples": 5,
        "reference_update_interval": 100,
        "reference_update_factor": 0.05,
        "pause_reference_update_during_drift": true,
        "drift_cooldown_period": 30,
        "use_adaptive_thresholds": false,
        "allow_runtime_threshold_adaptation": false,
        "adaptive_delta_std_multiplier": 1.5,
        "adaptive_lambda_std_multiplier": 5.0
      }
    ],
    "data_logger": {
      "enabled": true,
      "log_dir": "./logs",
      "log_images": true,
      "log_drift_events": true,
      "frame_log_interval": 10,
      "max_log_size_mb": 100
    }
  },
  "application": {
    "display_frames": false,
    "save_debug_frames": false,
    "debug_output_dir": "./debug"
  }
}