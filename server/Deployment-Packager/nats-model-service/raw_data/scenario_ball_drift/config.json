{
  "device": {
    "name": "Raspberry Pi Zero 2W",
    "description": "Scenario 2: Ball Drift Detection (ball triggers drift, lego recognized)",
    "log_level": "INFO"
  },
  "camera": {
    "resolution": [640, 480],
    "framerate": 10,
    "rotation": 0,
    "camera_index": 0,
    "force_cv2": false,
    "inference_resolution": [224, 224]
  },
  "model": {
    "model_path": "./model/model_object.tflite",
    "labels_path": "./model/labels_object.txt",
    "threshold": 0.75
  },
  "tinylcm": {
    "feature_extractor": {
      "type": "TFLiteFeatureExtractor",
      "model_path": "./model/model_object.tflite",
      "feature_layer_index": -1,
      "normalize_features": false,
      "lazy_loading": false
    },
    "feature_transformation": {
      "type": "StandardScalerPCA",
      "model_path": "./model/feature_processor.npz",
      "format": "npz",
      "enabled": true
    },
    "adaptive_classifier": {
      "type": "LightweightKNN",
      "k": 3,
      "max_samples": 200,
      "distance_metric": "euclidean",
      "weight_by_distance": true,
      "idw_power": 3.0,
      "initial_state_path": "./initial_state/knn_initial_state_objects.json"
    },
    "drift_detectors": [
      {
        "type": "KNNDistanceMonitor",
        "delta": 2,
        "lambda_threshold": 10,
        "exit_threshold_factor": 0.7,
        "high_confidence_threshold": 0.75,
        "stable_known_classes": ["lego", "stone", "leaf", "coin"],
        "reference_stats_path": "./initial_state/knn_reference_stats.json",
        "warm_up_samples": 0,
        "reference_update_interval": 10,
        "reference_update_factor": 0.01,
        "pause_reference_update_during_drift": true,
        "drift_cooldown_period": 0,
        "use_adaptive_thresholds": false,
        "allow_runtime_threshold_adaptation": false,
        "adaptive_delta_std_multiplier": 0.5,
        "adaptive_lambda_std_multiplier": 5.0,
        "aggregation_mode": "mean",
        "aggregation_q": 0.5
      }
    ],
    "data_logger": {
      "enabled": true,
      "log_dir": "./logs",
      "log_images": false,
      "log_drift_events": true,
      "frame_log_interval": 10,
      "max_log_size_mb": 100
    }
  },
  "application": {
    "inference_interval_ms": 200,
    "display_frames": false,
    "save_debug_frames": false,
    "debug_output_dir": "./debug"
  }
}
